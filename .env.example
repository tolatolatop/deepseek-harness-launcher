# Prefer `python scripts/init-env.py`; it generates secrets and absolute paths.
LAUNCHER_SECRET_KEY=
LAUNCHER_BOOTSTRAP_USERNAME=admin
LAUNCHER_BOOTSTRAP_PASSWORD=
LAUNCHER_PUBLIC_URL=http://localhost:18080/launcher
LAUNCHER_DATA_ROOT=/absolute/path/to/deepseek_harness/data
LAUNCHER_DATABASE_URL=postgresql+psycopg://launcher:CHANGE_ME@127.0.0.1:55432/launcher
# Optional: explicitly set this URL to select an existing MySQL database.
# LAUNCHER_DATABASE_URL=mysql+pymysql://launcher:URL_ENCODED_PASSWORD@mysql-host:3306/launcher?charset=utf8mb4
LAUNCHER_RUNTIME_IMAGE=runzhliu/deepseek-harness:0.2.1-rc.2-r1@sha256:ca8dd52ed949e3cbecc91a0c441ea627336ff23c68a640ca28db6e67a4337f73
LAUNCHER_DOCKER_PREFIX=dsh-launcher
LAUNCHER_CONTROL_CONTAINERS=
LAUNCHER_MAX_RUNNING=8
PORT=18080
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Only used when explicitly selecting compose.mysql.yaml.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
